generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AppSettings {
  id                    String   @id @default("default")
  appTitle              String   @map("app_title")
  subTitle              String   @map("sub_title")
  logoUrl               String?  @map("logo_url")
  themeColor            String   @default("AMBER_ORANGE") @map("theme_color")
  targetGoalAmount      Float    @default(200000) @map("target_goal_amount")
  targetGoalLabel       String   @default("Target Fund Goal") @map("target_goal_label")
  collectionButtonLabel String   @default("+ Collection") @map("collection_button_label")
  spendButtonLabel      String   @default("+ Spend / Bill") @map("spend_button_label")
  handoverButtonLabel   String   @default("Handover Cash") @map("handover_button_label")
  areaOptions           Json     @map("area_options")
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at")

  @@map("app_settings")
}

model User {
  id              String           @id
  name            String
  email           String           @unique
  role            String           @default("MEMBER")
  area            String?
  phone           String?
  image           String?
  isManual        Boolean          @default(false) @map("is_manual")
  createdAt       DateTime         @default(now()) @map("created_at")
  roleAssignment  RoleAssignment?

  @@map("users")
}

model RoleAssignment {
  email      String   @id
  role       String
  assignedBy String   @map("assigned_by")
  updatedAt  DateTime @default(now()) @updatedAt @map("updated_at")
  user       User?    @relation(fields: [email], references: [email], onDelete: Cascade)

  @@map("role_assignments")
}

model Contribution {
  id                  String   @id
  receiptNo           String   @unique @map("receipt_no")
  amount              Float
  paymentMode         String   @map("payment_mode")
  date                DateTime @default(now())
  memberId            String?  @map("member_id")
  memberName          String   @map("member_name")
  memberArea          String   @map("member_area")
  collectorId         String   @map("collector_id")
  collectorName       String   @map("collector_name")
  status              String   @default("APPROVED")
  approverEmail       String?  @map("approver_email")
  isSelfContribution  Boolean  @default(false) @map("is_self_contribution")
  isPrivate           Boolean  @default(false) @map("is_private")
  note                String?
  createdAt           DateTime @default(now()) @map("created_at")

  @@map("contributions")
}

model Expense {
  id            String   @id
  title         String
  category      String
  amount        Float
  isOutofPocket Boolean  @default(true) @map("is_out_of_pocket")
  isReimbursed  Boolean  @default(false) @map("is_reimbursed")
  paidByEmail   String   @map("paid_by_email")
  paidByName    String   @map("paid_by_name")
  receiptUrl    String?  @map("receipt_url")
  date          DateTime @default(now())
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("expenses")
}

model Handover {
  id            String   @id
  amount        Float
  collectorId   String   @map("collector_id")
  collectorName String   @map("collector_name")
  treasurerId   String?  @map("treasurer_id")
  treasurerName String?  @map("treasurer_name")
  status        String   @default("PENDING")
  notes         String?
  date          DateTime @default(now())
  createdAt     DateTime @default(now()) @map("created_at")

  @@map("handovers")
}

model CollectorTransfer {
  id                 String    @id
  contributionId     String?   @map("contribution_id")
  contributionIds    Json?     @map("contribution_ids")
  amount             Float
  fromCollectorEmail String    @map("from_collector_email")
  fromCollectorName  String    @map("from_collector_name")
  toCollectorEmail   String    @map("to_collector_email")
  toCollectorName    String    @map("to_collector_name")
  status             String    @default("PENDING")
  notes              String?
  createdAt          DateTime  @default(now()) @map("created_at")
  decidedAt          DateTime? @map("decided_at")

  @@map("collector_transfers")
}

model Programme {
  id               String   @id
  title            String
  description      String?
  dateTime         DateTime @map("date_time")
  location         String?
  photoUrl         String?  @map("photo_url")
  mediaType        String?  @map("media_type")
  embedUrl         String?  @map("embed_url")
  videoOrientation String?  @map("video_orientation")
  createdBy        String   @default("Super Admin") @map("created_by")
  createdAt        DateTime @default(now()) @map("created_at")

  @@map("programmes")
}

model MembershipRequest {
  id            String    @id
  userName      String    @map("user_name")
  userEmail     String    @map("user_email")
  userArea      String?   @map("user_area")
  requestedRole String    @default("MEMBER") @map("requested_role")
  status        String    @default("PENDING")
  decidedBy     String?   @map("decided_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  decidedAt     DateTime? @map("decided_at")

  @@map("membership_requests")
}

model Notification {
  id             String   @id
  recipientEmail String   @map("recipient_email")
  title          String
  message        String
  type           String
  targetId       String?  @map("target_id")
  isRead         Boolean  @default(false) @map("is_read")
  date           DateTime @default(now())

  @@map("notifications")
}

model UserActivity {
  id        String   @id
  userEmail String   @map("user_email")
  userName  String   @map("user_name")
  userRole  String   @map("user_role")
  action    String
  details   String?
  ipAddress String?  @map("ip_address")
  timestamp DateTime @default(now())

  @@map("user_activities")
}

